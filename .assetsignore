# Repository metadata and local tooling must never become public assets.
.git
.git/**
.gitignore
.github
.github/**
.wrangler
.wrangler/**
node_modules
node_modules/**
docs
docs/**
scripts
scripts/**

# Worker source/config is deployed by Wrangler, not served as a static file.
worker.js
wrangler.jsonc
.assetsignore
.htmlvalidate.json

# Internal planning and source documents.
README.md
BLUEPRINT_AI_SEARCH.md
COPYWRITING.md
PLAN.md
plan.md
PRD*.md
collor.md

# Local secrets, logs, and package metadata.
.env*
.dev.vars*
*.log
package.json
package-lock.json
pnpm-lock.yaml
yarn.lock
*.zip
*.rar
*.7z
*.tar
*.gz

# Hanya halaman dan bukti yang ditinjau yang boleh menjadi aset publik.
# Tambahkan pengecualian eksplisit saat bukti baru masuk proof-data.mjs.
bukti-kemenangan/*
!bukti-kemenangan/index.html
!bukti-kemenangan/1.svg
!bukti-kemenangan/2.svg
