{
  "name": "lelang-landing",
  "main": "worker.js",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/jasa-joki-lelang",
      "/jasa-joki-lelang/",
      "/cara-kerja",
      "/cara-kerja/",
      "/biaya",
      "/biaya/",
      "/faq",
      "/faq/",
      "/tentang",
      "/tentang/",
      "/kontak",
      "/kontak/",
      "/case-study",
      "/case-study/",
      "/bukti-kemenangan",
      "/bukti-kemenangan/",
      "/panduan/*",
      "/_markdown/*"
    ]
  }
}
